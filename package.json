    "exp:batch": "tsx experiments/cli/runBatch.ts",
    "exp:aggregate": "tsx experiments/cli/aggregate.ts",
    "exp:smoke": "tsx experiments/cli/experimentSmoke.ts",
    "baselines:bootstrap": "tsx experiments/baselines/bootstrap/bootstrap.ts",
    "baselines:build": "tsx experiments/baselines/bootstrap/build.ts",
    "baselines:verify": "tsx experiments/baselines/bootstrap/verify.ts",
    "baselines:smoke": "tsx experiments/cli/baselineSmoke.ts",
